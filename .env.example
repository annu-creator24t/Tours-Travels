# ==============================================================================
# Jay Maa Sheetala Tours & Travel — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env or .env.production / .env.local
# 2. Populate real secrets only in your secure environment / deployment platform.
# 3. DO NOT COMMIT .env OR ANY REAL CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' for live deployments, or 'development' / 'test' for local work
NODE_ENV="development"

# Canonical Public App URL (used in SEO sitemaps, canonical tags, and transactional emails)
# Production: "https://jaymaasheetalatours.com" (or your custom domain)
# Development: "http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# PostgreSQL Connection String (Direct or Connection Pooled / PgBouncer)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Production Example: "postgresql://app_user:strong_password@db-host.internal:5432/tourstravels?schema=public&sslmode=require"
DATABASE_URL="postgresql://postgres:password@localhost:5432/tours_travels?schema=public"

# ------------------------------------------------------------------------------
# 3. ADMIN AUTHENTICATION & SECURITY (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Secret key used for signing & verifying admin session JWTs.
# Generate a strong 64-character random string via: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Initial seed credentials (only used when running `npm run prisma:seed`)
ADMIN_DEFAULT_EMAIL="admin@tourstravels.com"
ADMIN_DEFAULT_PASSWORD="ChangeMeInProduction123!"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY CONFIGURATION (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# Razorpay Credentials
# For Live: use key IDs starting with 'rzp_live_'
# For Testing: use key IDs starting with 'rzp_test_'
# In production, ensure live keys are configured to accept real customer transactions.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Alternative / Modular Gateway Key Names (Optional alias fallback)
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 5. EMAIL & NOTIFICATIONS (MODULAR SMTP - OPTIONAL)
# ------------------------------------------------------------------------------
# If unconfigured, the system safely logs transactions without failing booking flows.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notifications@jaymaasheetalatours.com"
SMTP_PASS="your-smtp-app-password"
SMTP_SECURE="false"
SMTP_FROM="Jay Maa Sheetala Tours & Travel <notifications@jaymaasheetalatours.com>"

# ------------------------------------------------------------------------------
# 6. RATE LIMITING OVERRIDES (OPTIONAL - SENSIBLE DEFAULTS IN CODE)
# ------------------------------------------------------------------------------
# RATE_LIMIT_BOOKING_MAX="10"
# RATE_LIMIT_BOOKING_WINDOW_MS="600000"
# RATE_LIMIT_LOGIN_MAX="5"
# RATE_LIMIT_LOGIN_WINDOW_MS="900000"
# RATE_LIMIT_PAYMENT_MAX="15"
# RATE_LIMIT_PAYMENT_WINDOW_MS="600000"

# ------------------------------------------------------------------------------
# 7. PUBLIC BUSINESS & BRANDING METADATA (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME="Jay Maa Sheetala Tours & Travel"
NEXT_PUBLIC_COMPANY_PHONE="+919876543210"
NEXT_PUBLIC_COMPANY_PHONE_DISPLAY="+91 98765 43210"
NEXT_PUBLIC_COMPANY_WHATSAPP="+919876543210"
NEXT_PUBLIC_COMPANY_WHATSAPP_DISPLAY="+91 98765 43210"
NEXT_PUBLIC_COMPANY_EMAIL="contact@jaymaasheetalatours.com"
NEXT_PUBLIC_COMPANY_STREET="Main Office"
NEXT_PUBLIC_COMPANY_CITY="Varanasi"
NEXT_PUBLIC_COMPANY_STATE="Uttar Pradesh"
NEXT_PUBLIC_COMPANY_PINCODE="221001"
NEXT_PUBLIC_COMPANY_FULL_ADDRESS="Main Office, City Center, Varanasi, UP 221001"
NEXT_PUBLIC_JUSTDIAL_URL="https://www.justdial.com"
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_TWITTER_URL=""
NEXT_PUBLIC_GOOGLE_MAPS_URL=""
